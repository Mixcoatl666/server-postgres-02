{
  "compilerOptions": {
    "target": "ES2021",
    "outDir": "./dist", // ? Carpeta de salida
    "rootDir": "./src", // ? Carpeta raíz de código fuente
    "strict": true,
    "esModuleInterop": true,
    "moduleResolution": "Node16",
    "module": "Node16",
    "paths": {
      "@*": ["./src/*"]
    },
    "typeRoots": ["@types", "./node_modules/@types"]
  },
  "include": ["src"],
  "exclude": ["node_modules"],
  "ts-node": {
    "require": ["tsconfig-paths/register"]
  }
}